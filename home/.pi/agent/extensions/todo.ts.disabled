import { StringEnum } from "@earendil-works/pi-ai";
import type { ExtensionAPI, ExtensionContext } from "@earendil-works/pi-coding-agent";
import { Type } from "typebox";

const STATUSES = ["pending", "in_progress", "completed"] as const;
type TodoStatus = (typeof STATUSES)[number];

interface TodoItem {
	id: number;
	text: string;
	status: TodoStatus;
}

interface TodoDetails {
	items: TodoItem[];
}

const TodoParams = Type.Object({
	action: StringEnum(["set", "list", "update", "clear"] as const, {
		description:
			"set replaces the plan, list shows it, update changes one item's status or text, and clear removes all items",
	}),
	items: Type.Optional(
		Type.Array(Type.String(), {
			description:
			"For set: 5-9 meaningful implementation steps in execution order; each should name its concrete target and verification",
			minItems: 5,
			maxItems: 9,
		}),
	),
	id: Type.Optional(Type.Integer({ description: "For update: item ID", minimum: 1 })),
	status: Type.Optional(StringEnum(STATUSES, { description: "For update: new status" })),
	text: Type.Optional(Type.String({ description: "For update: replacement step text", minLength: 1 })),
});

function copyItems(items: TodoItem[]): TodoItem[] {
	return items.map((item) => ({ ...item }));
}

function formatItems(items: TodoItem[]): string {
	return items
		.map((item) => {
			const marker = item.status === "completed" ? "x" : item.status === "in_progress" ? ">" : " ";
			return `[${marker}] #${item.id} ${item.text}`;
		})
		.join("\n");
}

export default function todoExtension(pi: ExtensionAPI) {
	let items: TodoItem[] = [];

	function restore(ctx: ExtensionContext): void {
		items = [];
		for (const entry of ctx.sessionManager.getBranch()) {
			if (entry.type !== "message") continue;
			const message = entry.message;
			if (message.role !== "toolResult" || message.toolName !== "todo") continue;
			const details = message.details as TodoDetails | undefined;
			if (details?.items) items = copyItems(details.items);
		}
	}

	pi.on("session_start", async (_event, ctx) => restore(ctx));
	pi.on("session_tree", async (_event, ctx) => restore(ctx));

	pi.registerTool({
		name: "todo",
		label: "Todo",
		description:
			"Record and track the implementation plan. Start with action=set and exactly 5-9 meaningful steps in execution order, each naming its concrete target and verification. Use update as work progresses and list to review the plan.",
		promptSnippet: "Record, review, or update a persistent implementation todo list",
		parameters: TodoParams,

		async execute(_toolCallId, params) {
			switch (params.action) {
				case "set": {
					if (!params.items) throw new Error("todo set requires 5-9 items");
					const normalized = params.items.map((text) => text.trim());
					if (normalized.some((text) => text.length === 0)) {
						throw new Error("todo items must not be blank");
					}
					items = normalized.map((text, index) => ({ id: index + 1, text, status: "pending" }));
					break;
				}

				case "update": {
					if (params.id === undefined) throw new Error("todo update requires an id");
					if (params.status === undefined && params.text === undefined) {
						throw new Error("todo update requires a status or replacement text");
					}
					const item = items.find((candidate) => candidate.id === params.id);
					if (!item) throw new Error(`todo item #${params.id} does not exist`);
					if (params.status !== undefined) item.status = params.status;
					if (params.text !== undefined) {
						const text = params.text.trim();
						if (!text) throw new Error("todo item text must not be blank");
						item.text = text;
					}
					break;
				}

				case "list":
					if (items.length === 0) throw new Error("todo list is empty; initialize it with action=set");
					break;

				case "clear":
					items = [];
					break;
			}

			const snapshot = copyItems(items);
			return {
				content: [{ type: "text" as const, text: formatItems(snapshot) }],
				details: { items: snapshot } satisfies TodoDetails,
			};
		},
	});
}
